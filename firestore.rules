rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo la cuenta de Alberto (Google, con correo verificado).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sobrelacradojuegos@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ---------- Juegos ----------
    // Un jugador puede abrir un juego si conoce su id, pero no listarlos.
    match /games/{gameId} {
      allow get: if true;
      allow list, write: if isAdmin();

      // Pasos: el id aleatorio va dentro del QR. No se pueden listar.
      match /steps/{stepId} {
        allow get: if true;
        allow list, write: if isAdmin();
      }
    }

    // ---------- Partidas ----------
    match /runs/{runId} {
      // Se puede leer una partida solo conociendo su id (lo guarda el móvil del grupo).
      allow get: if true;
      // Quien haya iniciado sesión puede listar solo las partidas vinculadas a su cuenta (la consulta debe filtrar por su uid).
      allow list: if isAdmin() || (request.auth != null && resource.data.get('uid', null) == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if isAdmin() || isRunClosing(runId) || isRunClaiming() || isRunUnlinking();

      // "Mis casos": una partida sin dueño se vincula a la cuenta de quien la tiene en su móvil (solo el campo uid, una vez)…
      function isRunClaiming() {
        return request.auth != null
          && !('uid' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;
      }
      // …y su dueño puede desvincularla (el campo uid desaparece; la partida sigue existiendo para el administrador).
      function isRunUnlinking() {
        return request.auth != null
          && resource.data.get('uid', null) == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
          && !('uid' in request.resource.data);
      }

      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['gameId', 'alias', 'startedAt', 'endedAt'])
        && request.resource.data.gameId is string
        && request.resource.data.alias is string
        && request.resource.data.alias.size() <= 30
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null
        && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.active == true
      );

      // El jugador solo puede cerrar su partida, una vez, escaneando una solución.
      function isRunClosing(runId) {
        let run = resource.data;
        let game = get(/databases/$(database)/documents/games/$(run.gameId)).data;
        let endStep = request.resource.data.endStepId;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt', 'endStepId'])
          && run.endedAt == null
          && request.resource.data.endedAt == request.time
          && request.time < run.startedAt + duration.value(game.timeLimitMinutes, 'm')
          && endStep is string
          && get(/databases/$(database)/documents/games/$(run.gameId)/steps/$(endStep)).data.type == 'solution'
          && existsAfter(/databases/$(database)/documents/runs/$(runId)/scans/$(endStep));
      }

      // ---------- Escaneos ----------
      // El id del documento es el id del paso: un QR repetido se rechaza solo.
      match /scans/{stepId} {
        allow get: if true;
        allow list: if isAdmin() || (
          request.auth != null
          && get(/databases/$(database)/documents/runs/$(runId)).data.get('uid', null) == request.auth.uid
        );
        allow delete: if isAdmin();
        allow update: if isAdmin();

        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(['scannedAt'])
          && request.resource.data.scannedAt == request.time
          && isScanAllowed(runId, stepId)
        );

        function isScanAllowed(runId, stepId) {
          let run = get(/databases/$(database)/documents/runs/$(runId)).data;
          let game = get(/databases/$(database)/documents/games/$(run.gameId)).data;
          let step = get(/databases/$(database)/documents/games/$(run.gameId)/steps/$(stepId)).data;
          return run.endedAt == null
            && step.active == true
            && request.time < run.startedAt + duration.value(game.timeLimitMinutes, 'm');
        }
      }
    }

    // ---------- Avisos diarios del Diario ----------
    // Cada móvil que activa los avisos guarda su suscripción; el id es la huella del identificador (imposible de adivinar).
    // Nadie puede leerlas salvo el administrador; el envío lo hace un programa con clave de servicio (GitHub Actions).
    match /pushSubs/{id} {
      allow read: if isAdmin();
      allow create, update: if id.matches('[0-9a-f]{64}') && isValidSub(request.resource.data);
      allow delete: if id.matches('[0-9a-f]{64}');

      function isValidSub(d) {
        return d.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'at'])
          && d.keys().hasAll(['endpoint', 'p256dh', 'auth', 'at'])
          && d.endpoint is string && d.endpoint.matches('https://.*') && d.endpoint.size() <= 1000
          && d.p256dh is string && d.p256dh.size() <= 200
          && d.auth is string && d.auth.size() <= 100
          && d.at == request.time;
      }
    }

    // ---------- Perfil del jugador del Diario ----------
    // Al entrar con Google se guarda nombre y correo (para que Alberto sepa quién juega). Cada persona solo escribe y lee el suyo;
    // el administrador lista todos. El correo debe ser el de la sesión (no se puede inventar) y "first" no se puede cambiar.
    match /users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && isValidProfile(request.resource.data)
        && request.resource.data.first == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && isValidProfile(request.resource.data)
        && request.resource.data.first == resource.data.first;
      allow delete: if request.auth != null && request.auth.uid == uid;

      function isValidProfile(d) {
        return d.keys().hasOnly(['name', 'email', 'first', 'last'])
          && d.keys().hasAll(['name', 'email', 'first', 'last'])
          && d.name is string && d.name.size() <= 120
          && d.email is string && d.email == request.auth.token.email
          && request.auth.token.email_verified == true
          && d.first is timestamp
          && d.last == request.time;
      }
    }

    // ---------- Valoración de los casos ----------
    // Una por persona y caso (id = uid_juego). Solo se puede valorar un caso del que se tiene una partida TERMINADA en la propia
    // cuenta (endedAt solo se rellena escaneando la solución dentro del tiempo). La lee el dueño o el administrador.
    match /valoraciones/{id} {
      allow get: if request.auth != null && (id.matches(request.auth.uid + '_.*') || isAdmin());
      allow list: if isAdmin() || (request.auth != null && resource.data.get('uid', null) == request.auth.uid);
      allow create, update: if request.auth != null
        && isValidRating(request.resource.data)
        && id == request.auth.uid + '_' + request.resource.data.gameId;
      allow delete: if request.auth != null && id.matches(request.auth.uid + '_.*');

      function isValidRating(d) {
        let run = get(/databases/$(database)/documents/runs/$(d.runId)).data;
        return d.keys().hasOnly(['uid', 'gameId', 'runId', 'stars', 'comment', 'at'])
          && d.keys().hasAll(['uid', 'gameId', 'runId', 'stars', 'comment', 'at'])
          && d.uid == request.auth.uid
          && d.gameId is string && d.runId is string
          && d.stars is int && d.stars >= 1 && d.stars <= 5
          && d.comment is string && d.comment.size() <= 300
          && d.at == request.time
          && run.get('uid', null) == request.auth.uid
          && run.gameId == d.gameId
          && run.endedAt != null;
      }
    }

    // ---------- Progreso personal del Diario ----------
    // Cada persona (sesión de Google) lee y escribe solo lo suyo; el administrador puede leerlo.
    match /users/{uid}/diario/{day} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isValidDiaryDay(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;

      function isValidDiaryDay(d) {
        return d.keys().hasOnly(['done', 'tries', 'hint', 'ms', 'type', 'level', 'n', 'late', 'at'])
          && d.keys().hasAll(['done', 'tries', 'hint', 'ms', 'type', 'level', 'at'])
          && d.done is bool
          && d.hint is bool
          && d.tries is int && d.tries >= 0 && d.tries <= 999
          && d.ms is int && d.ms >= 0 && d.ms <= 86400000
          && d.type in ['cesar', 'morse', 'teclado', 'cerradura', 'anagrama', 'acrostico', 'simbolos', 'espejo', 'criptico', 'vigenere', 'golpes', 'interrogatorio', 'escitala', 'sopa', 'numeros', 'rebus', 'sinvocales', 'intruso', 'coartada', 'binario']
          && d.level is int && d.level >= 1 && d.level <= 5
          && (!('n' in d) || d.n is int)
          && (!('late' in d) || d.late is bool)
          && d.at == request.time;
      }
    }

    // ---------- Retos de nivel ----------
    // Un reto personal al día (id = fecha), con el mismo formato que un día del Diario más "i" (posición del acertijo: lista 0-999 o banco 1000+).
    match /users/{uid}/retos/{day} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isValidReto(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;

      function isValidReto(d) {
        return d.keys().hasOnly(['i', 'done', 'tries', 'hint', 'ms', 'type', 'level', 'at'])
          && d.keys().hasAll(['i', 'done', 'tries', 'hint', 'ms', 'type', 'level', 'at'])
          && d.i is int && d.i >= 0 && d.i < 5000
          && d.done is bool
          && d.hint is bool
          && d.tries is int && d.tries >= 0 && d.tries <= 999
          && d.ms is int && d.ms >= 0 && d.ms <= 86400000
          && d.type in ['cesar', 'morse', 'teclado', 'cerradura', 'anagrama', 'acrostico', 'simbolos', 'espejo', 'criptico', 'vigenere', 'golpes', 'interrogatorio', 'escitala', 'sopa', 'numeros', 'rebus', 'sinvocales', 'intruso', 'coartada', 'binario']
          && d.level is int && d.level >= 1 && d.level <= 5
          && d.at == request.time;
      }
    }

    // ---------- Cuaderno de detective ----------
    // Notas PRIVADAS de cada persona para cada caso: texto libre + lista de sospechosos (nombre y estado 0 sospechoso, 1 descartado, 2 culpable).
    // Solo su dueño las lee, las escribe y las borra: ni siquiera el administrador.
    match /users/{uid}/cuadernos/{gameId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && gameId.size() <= 100
        && isValidNotebook(request.resource.data);

      // Una regla no puede recorrer una lista: se comprueban uno a uno los 12 sitios posibles.
      function suspectOk(l, i) {
        return l.size() <= i || (l[i] is map && l[i].size() == 2 && l[i].n is string && l[i].n.size() > 0 && l[i].n.size() <= 40 && l[i].st in [0, 1, 2]);
      }
      function isValidNotebook(d) {
        return d.keys().hasOnly(['text', 'suspects', 'at'])
          && d.keys().hasAll(['text', 'suspects', 'at'])
          && d.text is string && d.text.size() <= 5000
          && d.suspects is list && d.suspects.size() <= 12
          && suspectOk(d.suspects, 0) && suspectOk(d.suspects, 1) && suspectOk(d.suspects, 2) && suspectOk(d.suspects, 3) && suspectOk(d.suspects, 4) && suspectOk(d.suspects, 5) && suspectOk(d.suspects, 6) && suspectOk(d.suspects, 7) && suspectOk(d.suspects, 8) && suspectOk(d.suspects, 9) && suspectOk(d.suspects, 10) && suspectOk(d.suspects, 11)
          && d.at == request.time;
      }
    }
    // ---------- Grupos de amigos (ranking semanal) ----------
    // Un grupo se identifica por un código de 6 caracteres. Quien lo conoce y tiene sesión puede ver su nombre y unirse; solo los miembros
    // ven la clasificación. Cada persona escribe únicamente su propia fila. El administrador puede leer nombres, miembros y puntos, pero NO el chat.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && code.matches('[A-HJ-NP-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['name', 'owner', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      function isMember(code) {
        return request.auth != null && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
      }
      function isGroupOwner(code) {
        return request.auth != null && get(/databases/$(database)/documents/groups/$(code)).data.owner == request.auth.uid;
      }
      function isMod(code) {
        return request.auth != null && exists(/databases/$(database)/documents/groups/$(code)/mods/$(request.auth.uid));
      }

      // Miembros: el nombre con el que sale cada persona en el grupo.
      match /members/{uid} {
        allow read: if isMember(code) || isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == uid
          && existsAfter(/databases/$(database)/documents/groups/$(code))
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null && (request.auth.uid == uid || isGroupOwner(code));
      }

      // Puntos de cada semana: id = lunes_uid (por ejemplo 2026-10-19_abc123). Solo cada persona escribe el suyo.
      match /scores/{id} {
        allow read: if isMember(code) || isAdmin();
        allow create, update: if isMember(code)
          && id == request.resource.data.week + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'week', 'pts', 'solved', 'streak', 'at'])
          && request.resource.data.keys().hasAll(['uid', 'week', 'pts', 'solved', 'streak', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.week is string && request.resource.data.week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts <= 4000
          && request.resource.data.solved is int && request.resource.data.solved >= 0 && request.resource.data.solved <= 14
          && request.resource.data.streak is int && request.resource.data.streak >= 0 && request.resource.data.streak <= 9999
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isGroupOwner(code));
      }

      // Moderadores del chat: personas del grupo a las que el creador da permiso para borrar mensajes. Solo el creador los nombra.
      match /mods/{uid} {
        allow read: if isMember(code);
        allow create: if isGroupOwner(code)
          && exists(/databases/$(database)/documents/groups/$(code)/members/$(uid))
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null && (request.auth.uid == uid || isGroupOwner(code));
      }

      // Chat del grupo. PRIVADO: solo lo leen los miembros (ni el administrador del juego). Se escribe con el nombre que cada persona tiene en el grupo;
      // no se editan. Borra el autor, el creador del grupo y los moderadores.
      match /messages/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == get(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid)).data.name
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isGroupOwner(code) || (isMember(code) && isMod(code)));
      }
    }

    // Lista personal de grupos de cada persona (para encontrarlos y borrarlos con la cuenta). La lee su dueño y el administrador.
    match /users/{uid}/grupos/{code} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && code.matches('[A-HJ-NP-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
